# Production database (PostgreSQL). See README for switching from the local JSON demo store to Prisma+Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/nikamobl?schema=public"

# Secret used to sign admin session JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# Seeded admin login (used by prisma/seed.ts and data/admin.json)
ADMIN_EMAIL="admin@nikamobl.ir"
ADMIN_PASSWORD="NikaAdmin@123"
